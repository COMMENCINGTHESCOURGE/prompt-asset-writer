{
  "name": "prompt-asset-writer",
  "version": "0.2.0",
  "description": "Text-only: prompts, manifests, acceptance docs. No visuals, no audio, no network.",
  "main": "dist/index.js",
  "bin": {
    "prompt-asset-writer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test",
    "accept": "bash ACCEPTANCE.sh"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.41",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "author": "DaShawn <COMMENCINGTHESCOURGE>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/COMMENCINGTHESCOURGE/prompt-asset-writer.git"
  },
  "engines": {
    "node": ">=18"
  }
}
